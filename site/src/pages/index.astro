---
import Base from '../layouts/Base.astro';
import items from '../data/items.json';
import cats from '../data/categories.json';

const cat = import.meta.glob('../data/categories/*.json', { eager: true });
const pageOf = (slug) => (cat[`../data/categories/${slug}.json`] as any)?.default;

const en = items.filter((i) => i.lang === 'en');
const label = Object.fromEntries(cats.map((c) => [c.slug, c.label]));

// Latest strip: the truly newest headlines (the fair ranking below is deliberately not date order).
const latest = [...en].sort((a, b) => b.published.localeCompare(a.published)).slice(0, 6);

// Featured: among the top of the fair ranking, favour stories many outlets covered, with a picture.
const pool = en.slice(0, 40).filter((i) => i.image);
const featured = pool.reduce((best, i) => (!best || (i.also?.length ?? 0) > (best.also?.length ?? 0) ? i : best), null);

// Sections: a fixed order of categories, each drawing from its own fairly-ranked page. An item shows once.
const order = ['new-models', 'racing', 'custom', 'classic', 'adventure', 'dirt-mx', 'for-sale', 'electric', 'sport-bikes', 'cruisers', 'gear', 'industry', 'events-rides', 'law-safety'];
const used = new Set([featured?.id]);
const sections = order.flatMap((slug) => {
  const page = pageOf(slug);
  if (!page) return [];
  const fresh = page.items.filter((i) => !used.has(i.id));
  const sure = (i) => (i.cat_scores?.[slug] ?? 1) >= 0.85;
  const lead = fresh.find((i) => i.image && sure(i)) ?? fresh.find((i) => i.image) ?? fresh[0];
  if (!lead) return [];
  const rest = fresh.filter((i) => i.id !== lead.id).slice(0, 3);
  [lead, ...rest].forEach((i) => used.add(i.id));
  // Extra stories for readers who expand this section ("more"). Not reserved, so a later section may also
  // use one; the view script hides an extra that is already showing elsewhere.
  const extra = page.items.filter((i) => !used.has(i.id)).slice(0, 6);
  return [{ slug, label: label[slug], lead, rest, extra, total: page.items.length }];
});

// Categories a reader can add to their home page as extra sections (src/scripts/views.ts).
const NOT_SUBJECTS = new Set(['odd-ball', 'other-languages', 'french', 'swedish', 'german', 'spanish', 'italian', 'dutch']);
const addable = cats.filter((c) => c.count > 0 && !NOT_SUBJECTS.has(c.slug)).map((c) => ({ slug: c.slug, label: c.label, parent: c.parent }));
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---
<Base wide>
  <div class="ticker" data-panel="latest">
    <b>LATEST NEWS:</b>
    <div class="track">{latest.map((i) => <a href={i.link} {...ext}>{i.title}</a>)}</div>
  </div>

  {featured && (
    <section data-panel="featured">
      <h2>Featured</h2>
      <div class="hero">
        <a class="img" href={featured.link} {...ext} tabindex="-1" aria-hidden="true">
          <img src={featured.image} alt="" decoding="async" referrerpolicy="no-referrer" />
        </a>
        <div>
          <h3><a href={featured.link} {...ext}>{featured.title}</a></h3>
          <p class="meta" data-v={featured.id} data-tags={featured.tags.join(' ')}>{featured.source} · <time datetime={featured.published}>{featured.published.slice(0, 10)}</time>
            {featured.categories.map((c) => (<> · <a href={`/c/${c.slug}/`}>{c.label}</a></>))}</p>
          {featured.excerpt && <p class="ex">{featured.excerpt}…</p>}
          {featured.also?.length > 0 && (
            <p class="also">Also covered by{' '}
              {featured.also.map((a, n) => (<>{n > 0 && ', '}<a href={a.link} {...ext}>{a.source}</a></>))}</p>
          )}
        </div>
      </div>
    </section>
  )}

  <div class="sections">
    {sections.map((s) => (
      <section class="sec" data-sec={s.slug}>
        <h2><a href={`/c/${s.slug}/`}>{s.label}</a></h2>
        <div class="lead">
          {s.lead.image && (
            <a class="img" href={s.lead.link} {...ext} tabindex="-1" aria-hidden="true">
              <img src={s.lead.image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
            </a>
          )}
          <h3><a href={s.lead.link} {...ext}>{s.lead.title}</a></h3>
          <p class="meta" data-v={s.lead.id} data-tags={s.lead.tags.join(' ')}>{s.lead.source} · <time datetime={s.lead.published}>{s.lead.published.slice(0, 10)}</time></p>
          {s.lead.excerpt && <p class="ex">{s.lead.excerpt.slice(0, 140)}…</p>}
        </div>
        {s.rest.map((i) => (
          <div class="line">
            <h3><a href={i.link} {...ext}>{i.title}</a></h3>
            <p class="meta" data-v={i.id} data-tags={i.tags.join(' ')}>{i.source} · <time datetime={i.published}>{i.published.slice(0, 10)}</time></p>
          </div>
        ))}
        {s.extra.map((i) => (
          <div class="line x-more" hidden>
            <h3><a href={i.link} {...ext}>{i.title}</a></h3>
            <p class="meta" data-v={i.id} data-tags={i.tags.join(' ')}>{i.source} · <time datetime={i.published}>{i.published.slice(0, 10)}</time></p>
          </div>
        ))}
        <p class="more"><a href={`/c/${s.slug}/`}>See more “{s.label}” ({s.total}) »</a></p>
      </section>
    ))}
  </div>
  <script type="application/json" id="addable" set:html={JSON.stringify(addable)}></script>
  <script is:inline>
    // The reader's saved home page (hidden, reordered and expanded sections), applied before first paint so the
    // default layout never flashes. Controls and added sections come from src/scripts/views.ts.
    (function () {
      var v; try { v = JSON.parse(localStorage.getItem('tdm.view.v1') || 'null'); } catch (e) {}
      if (!v || !v.sections) return;
      (v.hidden || []).forEach(function (p) { var el = document.querySelector('[data-panel="' + p + '"]'); if (el) el.hidden = true; });
      var box = document.querySelector('.sections');
      v.sections.forEach(function (s) {
        var el = box.querySelector('[data-sec="' + s.slug + '"]');
        if (!el) return;
        box.appendChild(el);
        el.hidden = !!s.hidden;
        if (s.expanded) el.querySelectorAll('.x-more').forEach(function (x) { x.hidden = false; });
      });
    })();
  </script>
</Base>

<style is:global>
  /* Reader views (src/scripts/views.ts): only present when JS runs. */
  .v-bar { display: flex; justify-content: flex-end; margin: 0.6rem 0 -0.4rem; }
  .v-bar button, .v-ctl button, .v-panel-home button { font: inherit; cursor: pointer; }
  .v-open { font-size: 0.8rem; padding: 0.25rem 0.8rem; border: 1px solid var(--line); border-radius: 1rem; background: #fff; color: #666; }
  .v-open:hover { border-color: var(--brand); color: var(--brand); }
  .sec h2 { display: flex; align-items: baseline; gap: 0.4rem; }
  .sec h2 > a { flex: 1; }
  .v-ctl { display: flex; gap: 0.25rem; font-size: 0.72rem; font-weight: 400; }
  .v-ctl button { padding: 0.05rem 0.5rem; border: 1px solid var(--line); border-radius: 0.8rem; background: #fff; color: #888; line-height: 1.5; }
  .v-ctl button:hover { border-color: var(--brand); color: var(--brand); }
  .v-ctl .v-hide { font-size: 0.9rem; line-height: 1.15; padding: 0 0.45rem; }
  .sec.x-open { break-inside: auto; }
  .v-panel-home { margin: 0.8rem 0; padding: 0.9rem 1rem; border: 1px solid var(--line); border-radius: 0.5rem; background: #fafafa; font-size: 0.88rem; }
  .v-head { display: flex; gap: 0.6rem; align-items: baseline; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .v-head span { color: var(--mute); font-size: 0.8rem; }
  .v-panels { display: flex; gap: 1.2rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .v-list { list-style: none; margin: 0; padding: 0; columns: 2 20rem; column-gap: 1.6rem; }
  .v-list li { display: flex; align-items: center; gap: 0.35rem; padding: 0.3rem 0; border-bottom: 1px solid var(--line); break-inside: avoid; }
  .v-list li.off .v-name { color: #aaa; }
  .v-list .v-name { flex: 1; min-width: 0; }
  .v-list .v-opt { color: var(--mute); font-size: 0.78rem; margin-right: 0.3rem; }
  .v-list button { min-width: 2.2rem; padding: 0.3rem 0.4rem; border: 1px solid var(--line); border-radius: 0.3rem; background: #fff; color: #555; }
  .v-list button:disabled { opacity: 0.35; cursor: default; }
  .v-list button[data-act="remove"] { min-width: 0; font-size: 0.75rem; color: var(--brand); }
  .v-list .v-pad { width: 3.6rem; }
  .v-add { display: flex; gap: 0.5rem; margin-top: 0.8rem; }
  .v-add select { flex: 1; min-width: 0; font: inherit; padding: 0.35rem; border: 1px solid #ccc; border-radius: 0.3rem; background: #fff; }
  .v-add button, .v-foot button { padding: 0.35rem 1rem; border-radius: 1rem; border: 1px solid var(--brand); background: #fff; color: var(--brand); }
  .v-foot { display: flex; justify-content: space-between; margin-top: 0.9rem; }
  .v-foot [data-act="done"] { background: var(--brand); color: #fff; }
  .v-toast { position: fixed; left: 50%; bottom: 1.2rem; transform: translateX(-50%); max-width: calc(100% - 2rem); padding: 0.6rem 1rem;
             background: #333; color: #fff; border-radius: 0.4rem; font-size: 0.85rem; box-shadow: 0 4px 14px rgba(0,0,0,.25); z-index: 10; }
  @media (max-width: 40rem) {
    .v-list .v-pad { display: none; }
    .v-ctl button { padding: 0.25rem 0.6rem; }   /* bigger tap targets */
  }
</style>
