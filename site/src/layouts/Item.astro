---
const { item } = Astro.props;
const date = item.published.slice(0, 10);
const also = item.also ?? [];
---
<article>
  <h3><a href={item.link} rel="noopener">{item.title}</a></h3>
  <p class="meta">
    {item.source} · {date}
    {item.categories.map((c) => (<> · <a href={`/c/${c.slug}/`}>{c.label}</a></>))}
  </p>
  {item.excerpt && <p class="ex">{item.excerpt}{item.excerpt.length >= 280 ? '…' : ''}</p>}
  {also.length > 0 && (
    <p class="also">Also covered by{' '}
      {also.map((a, n) => (<>{n > 0 && ', '}<a href={a.link} rel="noopener" title={a.title}>{a.source}</a></>))}
    </p>
  )}
</article>
