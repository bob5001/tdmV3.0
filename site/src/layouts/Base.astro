---
import categories from '../data/categories.json';
const { title = 'The Daily Motorcycle', description = 'A global view of what is happening with motorcycles.', wide = false } = Astro.props;
const nav = categories.filter((c) => c.count > 0);
const pathname = Astro.url.pathname;
const d = new Date();
const day = d.getDate();
const suffix = day % 10 === 1 && day !== 11 ? 'st' : day % 10 === 2 && day !== 12 ? 'nd' : day % 10 === 3 && day !== 13 ? 'rd' : 'th';
const today = `${day}${suffix} ${d.toLocaleString('en-GB', { month: 'long' })} ${d.getFullYear()}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:global>
      :root { --brand: #b83c67; --sky: #7fbde2; --ink: #3c3c3c; --mute: #777; --line: #e2e2e2; --link: #b83c67; --bg: #fff; --alert: #d23f37; }
      * { box-sizing: border-box; }
      body { font: 16px/1.5 Helvetica, Arial, sans-serif; color: var(--ink); background: var(--bg); margin: 0; }
      .wrap { max-width: 46rem; margin: 0 auto; padding: 0 1rem; }
      .wrap.wide { max-width: 72rem; }
      a { color: inherit; }
      header { text-align: center; padding: 1.4rem 0 0.7rem; position: relative; }
      header h1 { margin: 0; font-size: clamp(1.7rem, 5vw, 2.5rem); font-weight: 700; }
      header h1 a { color: var(--brand); text-decoration: none; }
      header .tag { margin: 0; color: var(--sky); font-size: 0.95rem; }
      header .date { font: 0.78rem Georgia, serif; color: var(--ink); position: absolute; right: 0; bottom: 0.3rem; }
      nav { text-align: center; font-size: 0.88rem; font-weight: 700; padding: 0.7rem 0; border-top: 1px solid var(--line); box-shadow: 0 6px 8px -8px rgba(0,0,0,.25); }
      nav a { display: inline-block; margin: 0.15rem 0.7rem; color: #666; text-decoration: none; white-space: nowrap; }
      nav a:hover, nav a[aria-current] { color: var(--brand); }
      nav .n { color: #aaa; font-weight: 400; font-size: 0.72rem; }
      .ticker { display: flex; gap: 0.8rem; align-items: center; border: 1px solid var(--line); margin: 1rem 0; font-size: 0.82rem; overflow: hidden; white-space: nowrap; }
      .ticker b { background: var(--alert); color: #fff; padding: 0.55rem 0.8rem; font-size: 0.72rem; letter-spacing: 0.03em; flex: none; }
      .ticker a { text-decoration: none; color: #555; flex: none; }
      .ticker a::before { content: '•'; margin-right: 0.8rem; color: #555; }
      h2 { font-size: 1.5rem; margin: 1.2rem 0 0.3rem; color: var(--sky); font-weight: 700; }
      h2 a { color: inherit; text-decoration: none; }
      h3 { margin: 0; font-size: 1.02rem; line-height: 1.3; }
      h3 a { color: #555; text-decoration: none; }
      h3 a:hover { color: var(--brand); }
      .meta { font-size: 0.78rem; color: var(--mute); margin: 0.2rem 0; }
      .meta a { color: var(--mute); }
      .ex { margin: 0.3rem 0 0; font-size: 0.86rem; color: #777; }
      .also { font-size: 0.78rem; color: var(--mute); margin: 0.3rem 0 0; }
      .also a { color: var(--brand); text-decoration: none; }
      .img { display: block; aspect-ratio: 3 / 2; background: #eee; overflow: hidden; }
      .img img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .list article { padding: 0.9rem 0; border-bottom: 1px solid var(--line); overflow: hidden; }
      .list .thumb { float: right; width: 7.5rem; margin: 0 0 0.3rem 0.9rem; }
      .hero { display: grid; grid-template-columns: 5fr 4fr; gap: 1.6rem; align-items: start; }
      .hero .img { aspect-ratio: 16 / 10; }
      .hero h3 { font-size: 1.45rem; }
      .hero .ex { font-size: 0.95rem; }
      .sections { columns: 3 17rem; column-gap: 1.6rem; }
      .sec { break-inside: avoid; margin: 0 0 1.4rem; }
      .sec h2 { margin-top: 0.2rem; border-bottom: 1px solid var(--line); padding-bottom: 0.2rem; }
      .sec .lead h3 { margin: 0.5rem 0 0; }
      .sec .line { padding: 0.55rem 0; border-top: 1px solid var(--line); }
      .sec .line:first-of-type { border-top: 0; }
      .more { font-size: 0.8rem; margin: 0.3rem 0 0; }
      .more a { color: var(--brand); text-decoration: none; }
      footer { font-size: 0.78rem; color: var(--mute); padding: 2rem 0; text-align: center; border-top: 1px solid var(--line); margin-top: 1rem; }
      @media (max-width: 40rem) { .hero { grid-template-columns: 1fr; } header .date { position: static; margin-top: 0.3rem; } }
    </style>
  </head>
  <body>
    <div class={`wrap${wide ? ' wide' : ''}`}>
      <header>
        <h1><a href="/">TheDailyMotorcycle.com</a></h1>
        <p class="tag">Your daily dose from all over the web.</p>
        <div class="date">{today}</div>
      </header>
      <nav aria-label="Categories">
        <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
        {nav.map((c) => (
          <a href={`/c/${c.slug}/`} aria-current={pathname === `/c/${c.slug}/` ? 'page' : undefined}>
            {c.label} <span class="n">{c.count}</span>
          </a>
        ))}
        <a href="/sources/" aria-current={pathname === '/sources/' ? 'page' : undefined}>Sources</a>
      </nav>
      <main><slot /></main>
      <footer>
        Links out to the sources; articles belong to their publishers. Categories are assigned by a classifier and are sometimes wrong.
      </footer>
    </div>
  </body>
</html>
