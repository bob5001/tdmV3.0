---
import categories from '../data/categories.json';
import meta from '../data/meta.json';
const { title = 'The Daily Motorcycle', description = 'A global view of what is happening with motorcycles.', wide = false } = Astro.props;
const nav = categories.filter((c) => c.count > 0 && !c.parent);       // top-level only; children appear as chips on their parent
const pathname = Astro.url.pathname;
// Newspaper-style date. Built pages show when the data was last exported; the script below swaps in
// the reader's today plus "updated 2h ago", so a stale build never claims to be today's paper.
const longDate = (d) => {
  const day = d.getDate();
  const suffix = day % 10 === 1 && day !== 11 ? 'st' : day % 10 === 2 && day !== 12 ? 'nd' : day % 10 === 3 && day !== 13 ? 'rd' : 'th';
  return `${day}${suffix} ${d.toLocaleString('en-GB', { month: 'long' })} ${d.getFullYear()}`;
};
const updated = meta.updated;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:global>
      :root { --brand: #b83c67; --sky: #7fbde2; --ink: #3c3c3c; --mute: #777; --line: #e2e2e2; --link: #b83c67; --bg: #fff; --alert: #d23f37; }
      * { box-sizing: border-box; }
      body { font: 16px/1.5 Helvetica, Arial, sans-serif; color: var(--ink); background: var(--bg); margin: 0; }
      .wrap { max-width: 46rem; margin: 0 auto; padding: 0 1rem; }
      .wrap.wide { max-width: 72rem; }
      a { color: inherit; }
      header { text-align: center; padding: 1.4rem 0 0.7rem; position: relative; }
      header h1 { margin: 0; font-size: clamp(1.7rem, 5vw, 2.5rem); font-weight: 700; }
      header h1 a { color: var(--brand); text-decoration: none; }
      header .tag { margin: 0; color: var(--sky); font-size: 0.95rem; }
      header .date { font: 0.78rem Georgia, serif; color: var(--ink); position: absolute; right: 0; bottom: 0.3rem; }
      nav { text-align: center; font-size: 0.88rem; font-weight: 700; padding: 0.7rem 0; border-top: 1px solid var(--line); box-shadow: 0 6px 8px -8px rgba(0,0,0,.25); }
      nav a { display: inline-block; margin: 0.15rem 0.7rem; color: #666; text-decoration: none; white-space: nowrap; }
      nav a:hover, nav a[aria-current] { color: var(--brand); }
      nav .n { color: #aaa; font-weight: 400; font-size: 0.72rem; }
      .ticker { display: flex; align-items: center; border: 1px solid var(--line); margin: 1rem 0; font-size: 0.82rem; white-space: nowrap; }
      .ticker b { background: var(--alert); color: #fff; padding: 0.55rem 0.8rem; font-size: 0.72rem; letter-spacing: 0.03em; flex: none; }
      .ticker .track { display: flex; gap: 0.8rem; padding-left: 0.8rem; overflow-x: auto; scrollbar-width: none; }
      .ticker .track::-webkit-scrollbar { display: none; }
      .ticker a { text-decoration: none; color: #555; flex: none; }
      .ticker a:hover { color: var(--brand); }
      .ticker a::before { content: '•'; margin-right: 0.8rem; color: #555; }
      h2 { font-size: 1.5rem; margin: 1.2rem 0 0.3rem; color: var(--sky); font-weight: 700; }
      h2 a { color: inherit; text-decoration: none; }
      h3 { margin: 0; font-size: 1.02rem; line-height: 1.3; }
      h3 a { color: #555; text-decoration: none; }
      h3 a:hover { color: var(--brand); }
      .meta { font-size: 0.78rem; color: var(--mute); margin: 0.2rem 0; }
      .meta a { color: var(--mute); }
      .ex { margin: 0.3rem 0 0; font-size: 0.86rem; color: #777; }
      .also { font-size: 0.78rem; color: var(--mute); margin: 0.3rem 0 0; }
      .also a { color: var(--brand); text-decoration: none; }
      .img { display: block; aspect-ratio: 3 / 2; background: #eee; overflow: hidden; }
      .img img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .list article { padding: 0.9rem 0; border-bottom: 1px solid var(--line); overflow: hidden; }
      .list .thumb { float: right; width: 7.5rem; margin: 0 0 0.3rem 0.9rem; }
      .hero { display: grid; grid-template-columns: 5fr 4fr; gap: 1.6rem; align-items: start; }
      .hero .img { aspect-ratio: 16 / 10; }
      .hero.noimg { grid-template-columns: 1fr; }
      .hero h3 { font-size: 1.45rem; }
      .hero .ex { font-size: 0.95rem; }
      .sections { columns: 3 17rem; column-gap: 1.6rem; }
      .sec { break-inside: avoid; margin: 0 0 1.4rem; }
      .sec h2 { margin-top: 0.2rem; border-bottom: 1px solid var(--line); padding-bottom: 0.2rem; }
      .sec .lead h3 { margin: 0.5rem 0 0; }
      .sec .line { padding: 0.55rem 0; border-top: 1px solid var(--line); }
      .sec .line:first-of-type { border-top: 0; }
      .chips { margin: 0.3rem 0 0.6rem; font-size: 0.85rem; }
      .chips a { display: inline-block; margin: 0 0.4rem 0.4rem 0; padding: 0.15rem 0.7rem; border: 1px solid var(--line); border-radius: 1rem; color: #666; text-decoration: none; }
      .chips a:hover { border-color: var(--brand); color: var(--brand); }
      .chips .n { color: #aaa; font-size: 0.72rem; }
      .crumb { font-size: 0.85rem; margin: 1rem 0 0; }
      .crumb a { color: var(--brand); text-decoration: none; }
      .form { font-style: italic; }
      .form a { color: #6a8fb0; }
      .more { font-size: 0.8rem; margin: 0.3rem 0 0; }
      .more a { color: var(--brand); text-decoration: none; }
      footer { font-size: 0.78rem; color: var(--mute); padding: 2rem 0; text-align: center; border-top: 1px solid var(--line); margin-top: 1rem; }
      img { max-width: 100%; }
      /* The date sits bottom-right beside the tagline only when there is room for both. */
      @media (max-width: 48rem) { header .date { position: static; margin-top: 0.2rem; } }
      h3, .ex, code { overflow-wrap: anywhere; }
      /* Phones: nav and ticker become single swipeable rows instead of wrapping into a wall of links. */
      @media (max-width: 40rem) {
        header { padding: 1rem 0 0.5rem; }
        header .tag { font-size: 0.88rem; }
        nav { display: flex; overflow-x: auto; scrollbar-width: none; margin: 0 -1rem; padding: 0.5rem 1rem; text-align: left;
              -webkit-mask-image: linear-gradient(to right, #000 85%, transparent); mask-image: linear-gradient(to right, #000 85%, transparent); }
        nav::-webkit-scrollbar { display: none; }
        nav a { flex: none; margin: 0; padding: 0.45rem 0.6rem; }
        nav a:last-child { margin-right: 2rem; }
        .hero { grid-template-columns: 1fr; gap: 0.8rem; }
        .hero h3 { font-size: 1.25rem; }
        h2 { font-size: 1.35rem; }
        .list .thumb { width: 5.5rem; margin-left: 0.7rem; }
        .chips a { padding: 0.3rem 0.75rem; }
      }
    </style>
  </head>
  <body>
    <div class={`wrap${wide ? ' wide' : ''}`}>
      <header>
        <h1><a href="/">TheDailyMotorcycle.com</a></h1>
        <p class="tag">Your daily dose from all over the web.</p>
        <div class="date" data-updated={updated}>Updated {longDate(new Date(updated))}</div>
      </header>
      <nav aria-label="Categories">
        <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
        <a href="/search/" aria-current={pathname === '/search/' ? 'page' : undefined}>Search</a>
        {nav.map((c) => (
          <a href={`/c/${c.slug}/`} aria-current={pathname === `/c/${c.slug}/` ? 'page' : undefined}>
            {c.label} <span class="n">{c.count}</span>
          </a>
        ))}
        <a href="/forms/" aria-current={pathname.startsWith('/forms') || pathname.startsWith('/f/') ? 'page' : undefined}>Forms</a>
        <a href="/sources/" aria-current={pathname === '/sources/' ? 'page' : undefined}>Sources</a>
      </nav>
      <main><slot /></main>
      <footer>
        Links out to the sources; articles belong to their publishers. Categories are assigned by a classifier and are sometimes wrong.
      </footer>
    </div>
    <script>
      // Small enhancements only; every page works without this.
      import { ago, relativeTimes } from '../scripts/ago';

      // Freshness: header shows the reader's today plus how long ago the data was exported,
      // and item dates within the last week read as "3h ago" (full date kept in the tooltip).
      const stamp = document.querySelector<HTMLElement>('header .date');
      if (stamp?.dataset.updated) {
        const d = new Date();
        const day = d.getDate();
        const suffix = day % 10 === 1 && day !== 11 ? 'st' : day % 10 === 2 && day !== 12 ? 'nd' : day % 10 === 3 && day !== 13 ? 'rd' : 'th';
        const since = ago(stamp.dataset.updated);
        if (since) stamp.textContent = `${day}${suffix} ${d.toLocaleString('en-GB', { month: 'long' })} ${d.getFullYear()} · updated ${since}`;
      }
      relativeTimes();

      // Pictures are loaded from the sources' own servers; hide the box when one fails.
      // Listening on the document also catches pictures added later (search results).
      const dropImage = (img: HTMLImageElement) => {
        const box = img.closest('.img');
        box?.closest('.hero')?.classList.add('noimg');
        box?.remove();
      };
      document.querySelectorAll<HTMLImageElement>('.img img').forEach((img) => {
        if (img.complete && img.naturalWidth === 0) dropImage(img);
      });
      document.addEventListener('error', (e) => {
        if (e.target instanceof HTMLImageElement) dropImage(e.target);
      }, true);

      // Phones: bring the current section into view in the swipeable nav.
      const nav = document.querySelector('nav');
      const here = nav?.querySelector('[aria-current]');
      if (nav && here && nav.scrollWidth > nav.clientWidth) {
        const n = nav.getBoundingClientRect(), h = here.getBoundingClientRect();
        nav.scrollLeft += h.left - n.left - (n.width - h.width) / 2;
      }

      // Ticker: drifts left in a loop; stops while the reader hovers, touches, focuses or swipes it,
      // and never moves for readers who ask for reduced motion.
      const track = document.querySelector<HTMLElement>('.ticker .track');
      if (track && !matchMedia('(prefers-reduced-motion: reduce)').matches && track.scrollWidth > track.clientWidth) {
        const originals = [...track.children] as HTMLElement[];
        originals.forEach((a) => {
          const copy = a.cloneNode(true) as HTMLElement;
          copy.setAttribute('aria-hidden', 'true');
          copy.tabIndex = -1;
          track.append(copy);
        });
        const loop = (track.children[originals.length] as HTMLElement).offsetLeft - originals[0].offsetLeft;
        let held = false, resumeAt = 0, pos = 0, last = 0;
        const hold = () => { held = true; };
        const release = (delay: number) => () => { held = false; resumeAt = performance.now() + delay; };
        track.addEventListener('mouseenter', hold);
        track.addEventListener('mouseleave', release(0));
        track.addEventListener('focusin', hold);
        track.addEventListener('focusout', release(0));
        track.addEventListener('touchstart', hold, { passive: true });
        track.addEventListener('touchend', release(2500));
        const step = (now: number) => {
          const dt = last ? Math.min(now - last, 100) : 0;
          last = now;
          if (held || now < resumeAt) pos = track.scrollLeft;   // the reader may have swiped; carry on from there
          else {
            pos += dt * 0.04;                                    // 40px per second
            if (pos >= loop) pos -= loop;
            track.scrollLeft = pos;
          }
          requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }
    </script>
  </body>
</html>
