---
import categories from '../data/categories.json';
const { title = 'The Daily Motorcycle', description = 'A global view of what is happening with motorcycles.' } = Astro.props;
const nav = categories.filter((c) => c.count > 0);
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style>
      :root { --ink: #1a1a1a; --mute: #666; --line: #ddd; --link: #0b4f9c; --bg: #fdfdfb; }
      body { font: 17px/1.5 Georgia, 'Times New Roman', serif; color: var(--ink); background: var(--bg); margin: 0; }
      .wrap { max-width: 46rem; margin: 0 auto; padding: 0 1rem; }
      header { border-bottom: 3px double var(--ink); padding: 1.2rem 0 0.6rem; }
      header h1 { margin: 0; font-size: 2rem; letter-spacing: 0.02em; }
      header h1 a { color: inherit; text-decoration: none; }
      header p { margin: 0.2rem 0 0.6rem; color: var(--mute); font-style: italic; }
      nav { font: 0.9rem/1.9 system-ui, sans-serif; padding: 0.4rem 0; border-bottom: 1px solid var(--line); }
      nav a { margin-right: 0.9rem; white-space: nowrap; color: var(--link); text-decoration: none; }
      nav a[aria-current] { color: var(--ink); font-weight: 700; }
      nav .n { color: var(--mute); font-size: 0.75rem; }
      h2 { font-size: 1.3rem; margin: 1.5rem 0 0.3rem; }
      article { padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
      article h3 { margin: 0; font-size: 1.1rem; line-height: 1.3; }
      article a { color: var(--link); }
      .meta { font: 0.8rem system-ui, sans-serif; color: var(--mute); margin: 0.2rem 0; }
      .meta a { color: var(--mute); }
      .ex { margin: 0.2rem 0 0; font-size: 0.95rem; }
      .also { font: 0.82rem system-ui, sans-serif; color: var(--mute); margin: 0.3rem 0 0; }
      .also a { color: var(--link); }
      footer { font: 0.8rem system-ui, sans-serif; color: var(--mute); padding: 2rem 0; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <h1><a href="/">The Daily Motorcycle</a></h1>
        <p>Links out to the sources. We only sort.</p>
      </header>
      <nav aria-label="Categories">
        <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Everything</a>
        {nav.map((c) => (
          <a href={`/c/${c.slug}/`} aria-current={pathname === `/c/${c.slug}/` ? 'page' : undefined}>
            {c.label} <span class="n">{c.count}</span>
          </a>
        ))}
        <a href="/sources/" aria-current={pathname === '/sources/' ? 'page' : undefined}>Sources</a>
      </nav>
      <main><slot /></main>
      <footer>
        Articles belong to their publishers; every headline links to the original.
        Categories are assigned by a classifier and are sometimes wrong.
      </footer>
    </div>
  </body>
</html>
